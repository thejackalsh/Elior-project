# ─────────────────────────────────────────────────────────────────────────────
# ELIOR — konfigurasi docker-compose
# Salin ke .env lalu isi. File .env TIDAK boleh di-commit.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=elior
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=eliordb

# ── Backend ──────────────────────────────────────────────────────────────────
# WAJIB. Minimal 32 karakter — backend menolak start kalau lebih pendek.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Email yang diperlakukan sebagai admin (tidak dihitung dalam kuota 50 user).
ADMIN_EMAIL=admin@example.com

# Alamat bind server admin, mis. 127.0.0.1:8081.
# Biarkan KOSONG — panel admin tidak disertakan di repo ini.
ADMIN_BIND=

# ── Inference ────────────────────────────────────────────────────────────────
# Default: container `inference` lokal (docker compose --profile ai up).
# Untuk memakai HuggingFace Space MILIKMU SENDIRI, isi URL Space-mu di sini:
#   GRADIO_SPACE_URL=https://<user>-<space>.hf.space
GRADIO_SPACE_URL=http://inference:7860

# Hanya dibutuhkan kalau GRADIO_SPACE_URL menunjuk ke *.hf.space.
# Ambil di huggingface.co/settings/tokens (akses "read" sudah cukup).
HF_TOKEN=

# ── Web (landing page) ───────────────────────────────────────────────────────
# Dibakar ke bundle klien saat build. Setelah diubah, jalankan:
#   docker compose build web
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_KEY=
