# Salin ke .env:  cp .env.example .env
#
# Hanya untuk menjalankan backend LANGSUNG di mesin (go run .).
# Kalau pakai Docker, nilai-nilai ini datang dari .env di root repo
# lewat docker-compose.yml — file ini tidak dibaca.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/eliordb

# true kalau database remote menuntut SSL (Supabase, VPS). Lokal: false.
DATABASE_SSL=false

# ── Keamanan ─────────────────────────────────────────────────────────────────
# WAJIB minimal 32 karakter — backend menolak start kalau lebih pendek.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Email yang diperlakukan sebagai admin. Tidak dihitung dalam kuota 50 user.
ADMIN_EMAIL=admin@example.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# Alamat bind server publik. Di dalam container WAJIB 0.0.0.0,
# kalau 127.0.0.1 tidak bisa diakses dari luar container.
BIND_ADDR=127.0.0.1

# Alamat bind server admin, mis. 127.0.0.1:8081.
# Kosongkan untuk mematikan server admin sepenuhnya.
ADMIN_BIND=

# ── Penyimpanan ──────────────────────────────────────────────────────────────
# Folder tujuan upload gambar. WAJIB diisi — backend menolak start tanpa ini.
UPLOAD_DIR=./uploads
