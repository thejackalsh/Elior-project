# Salin ke .env:  cp .env.example .env
#
# Emulator Android TIDAK bisa memakai "localhost" — itu merujuk ke emulator
# sendiri, bukan komputermu. Gunakan 10.0.2.2.
# HP fisik: pakai IP LAN komputermu, mis. http://192.168.1.10:8080

# Backend Go (auth, riwayat, config)
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:8080

# Proxy inference (mode objek). Port 7861 sesuai docker-compose.
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:7861

# Provider layanan — nilai default jalan tanpa API key apa pun
EXPO_PUBLIC_STT_PROVIDER=native
EXPO_PUBLIC_TTS_PROVIDER=rn-tts
EXPO_PUBLIC_OCR_PROVIDER=mlkit

# Lewati layar login saat pengembangan (jangan dipakai di build rilis)
EXPO_PUBLIC_DEV_BYPASS_AUTH=false

# ── Google Sign-In (OPSIONAL) ────────────────────────────────────────────────
# Kosongkan kalau cukup pakai login email/password.
# Kalau diisi, wajib juga menaruh google-services.json milikmu sendiri di
# android/app/ (lihat google-services.json.example).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Google Cloud (OPSIONAL) ──────────────────────────────────────────────────
# Hanya perlu kalau provider di atas diganti ke google-cloud.
EXPO_PUBLIC_GOOGLE_STT_KEY=
EXPO_PUBLIC_GOOGLE_TTS_KEY=
EXPO_PUBLIC_GOOGLE_VISION_KEY=
